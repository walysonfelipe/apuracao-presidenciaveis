# Bun lê .env automaticamente. Copie este exemplo para .env.
# Cobertura nacional descoberta pela configuração oficial do TSE.
# Filtros opcionais para ensaios: sp, 2 e 1,3,5,6,7,8.
COLLECTOR_UF=all
COLLECTOR_ROUND=all
COLLECTOR_OFFICES=all
COLLECTOR_DB=.collector/results.sqlite
# Todas as consultas, inclusive configurações, passam pelo mesmo limite.
COLLECTOR_RPS=40
COLLECTOR_CONCURRENCY=8
COLLECTOR_BATCH_SIZE=500
COLLECTOR_TIMEOUT_MS=8000
COLLECTOR_MAX_BYTES=5242880
COLLECTOR_REGIONAL_INTERVAL_MS=30000
COLLECTOR_MUNICIPAL_INTERVAL_MS=300000
COLLECTOR_OTHER_MUNICIPAL_INTERVAL_MS=3600000
COLLECTOR_COMPLETE_INTERVAL_MS=600000
COLLECTOR_CONFIG_INTERVAL_MS=300000
# No Railway, PORT é injetado pela plataforma.
PORT=3000
API_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://corridaeleicao.vercel.app,https://eleicoes.agendasalao.com

# Ative somente após configurar uma chave nova, restrita ao bucket do coletor.
R2_ENABLED=false
R2_ACCOUNT_ID=<ACCOUNT_ID>
R2_ACCESS_KEY_ID=<ACCESS_KEY_ID>
R2_SECRET_ACCESS_KEY=<SECRET_ACCESS_KEY>
R2_BUCKET=eleicao
R2_PREFIX=resultados
# Domínio público ligado ao R2; não é o endpoint S3. Opcional para o upload.
R2_PUBLIC_BASE_URL=https://eleicoes.agendasalao.com
R2_PUBLISH_INTERVAL_MS=15000
R2_HEARTBEAT_INTERVAL_MS=60000
R2_TIMEOUT_MS=15000
R2_RETENTION_HOURS=48
