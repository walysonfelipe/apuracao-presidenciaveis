# Copie para .env.local. Todas as variáveis são opcionais.
# Consultas ao TSE: todas passam pelo mesmo limite por segundo do processo.
TSE_RPS=40
TSE_CONCURRENCY=8
TSE_TIMEOUT_MS=8000
# Intervalo mínimo entre leituras de Brasil/UFs e de municípios; apuração completa usa o maior.
REGIONAL_INTERVAL_MS=30000
MUNICIPAL_INTERVAL_MS=180000
COMPLETE_INTERVAL_MS=600000

# Mini workers: ligados por padrão em produção (npm start) e desligados em npm run dev.
# Use false nas instâncias extras; apenas uma deve rodar workers.
BACKGROUND_WORKERS=
WORKERS=4
# Itens por fatia; fatias menores alternam mais entre estados.
WORKER_SLICE=40
# latest = turno mais recente configurado pelo TSE; ou 1, 2 ou 1,2.
WORKER_ROUNDS=latest

# R2 guarda os pedaços (turno/UF) para reinícios e várias instâncias.
# Sem estas três variáveis, o cache fica apenas na memória do servidor.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=eleicao
R2_PREFIX=presidente
R2_PERSIST_INTERVAL_MS=10000
